<% content_for :description, "Annie Walsh builds websites and web apps, and dances, in London. Pick a side." %>

<main class="split">
  <header class="split__top">
    <span class="site-header__name">Annie Walsh</span>
    <span class="split__prompt">pick a side —</span>
    <span class="eyebrow" style="letter-spacing: 0; text-transform: none; font-size: 15px;">London ✶</span>
  </header>

  <div class="split__halves">
    <%= link_to code_path, class: "half half--code", aria: { label: "Code: websites, web apps and arts tech" } do %>
      <span class="shape" aria-hidden="true" style="right: -80px; top: 60px; width: 360px; height: 360px; border-radius: 50%; background: var(--yellow);"></span>
      <span class="shape shape--hide-sm" aria-hidden="true" style="right: 180px; top: 300px; width: 180px; height: 90px; border-radius: 180px 180px 0 0; background: var(--pink);"></span>
      <span class="shape" aria-hidden="true" style="left: 40px; top: 120px; width: 120px; height: 120px; border: 3px solid var(--cream); border-radius: 24px; transform: rotate(14deg);"></span>

      <span class="eyebrow">Websites · Web apps · Arts tech</span>
      <span class="half__body">
        <span class="half__lead">I build</span>
        <span class="half__word">Code</span>
        <span class="pill pill--cream half__cta">Hire me for a project →</span>
      </span>
    <% end %>

    <%= link_to dance_path, class: "half half--dance", aria: { label: "Dance: performances in London" } do %>
      <%= image_tag "two_worlds/amal.jpg", alt: "", class: "half__photo", aria: { hidden: true } %>
      <span class="shape shape--hide-sm" aria-hidden="true" style="right: 290px; top: 300px; width: 140px; height: 140px; border-radius: 50%; background: var(--orange);"></span>
      <span class="shape" aria-hidden="true" style="left: -40px; top: 210px; width: 240px; height: 40px; border-radius: 999px; background: var(--violet); transform: rotate(-18deg);"></span>

      <span class="eyebrow">Performance · London</span>
      <span class="half__body">
        <span class="half__lead">I move</span>
        <span class="half__word">Dance</span>
        <span class="pill pill--ink half__cta">See performances →</span>
      </span>
    <% end %>
  </div>
</main>
