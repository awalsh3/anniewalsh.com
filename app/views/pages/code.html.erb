<% content_for :title, "Code" %>
<% content_for :description, "Freelance web developer in London. Websites, Ruby on Rails apps and arts tech for artists, arts organisations and small businesses." %>

<header class="wrap site-header">
  <%= link_to "Annie Walsh", root_path, class: "site-header__name" %>
  <nav class="site-nav" aria-label="Code">
    <a href="#services">Services</a>
    <a href="#work">Work</a>
    <a href="#about">About</a>
    <%= link_to "Dance →", dance_path, class: "pill pill--sm pill--rose" %>
  </nav>
</header>

<main>
  <section class="wrap--tight">
    <div class="panel code-hero">
      <span class="shape" aria-hidden="true" style="right: -60px; top: -60px; width: 420px; height: 420px; border-radius: 50%; background: var(--yellow);"></span>
      <span class="shape shape--hide-sm" aria-hidden="true" style="right: 300px; top: 220px; width: 200px; height: 100px; border-radius: 200px 200px 0 0; background: var(--pink);"></span>
      <span class="shape shape--hide-sm" aria-hidden="true" style="right: 120px; top: 380px; width: 110px; height: 110px; border-radius: 22px; background: var(--mint); transform: rotate(18deg);"></span>

      <span class="eyebrow">Freelance web developer · London</span>
      <h1 class="display">The code is the <span class="serif">easy part.</span></h1>
      <p>AI can write it. I handle everything around it: working out what to build, how it should feel, keeping it secure, launching it and looking after it. </p>
      <div class="btn-row">
        <%= link_to "Start a project", linkedin_url, class: "pill pill--cream", target: "_blank", rel: "noopener" %>
        <a href="#work" class="pill pill--outline-light">See the work</a>
      </div>
    </div>
  </section>

  <section id="services" class="wrap services">
    <h2 class="display h-section">What I can <span class="serif">make</span> for you</h2>
    <div class="card-grid">
      <article class="panel service" style="background: var(--yellow);">
        <span class="shape" aria-hidden="true" style="right: -40px; top: -40px; width: 180px; height: 180px; border-radius: 50%; background: var(--pink);"></span>
        <span class="service__n">01</span>
        <div class="service__body">
          <h3>Websites</h3>
          <p>Sites for small businesses, artists and organisations that feel like you, load fast and are easy to update.</p>
          <span class="service__includes">Design · Build · Domains, hosting &amp; email</span>
        </div>
      </article>
      <article class="panel service" style="background: var(--pink);">
        <span class="shape" aria-hidden="true" style="right: -40px; top: -40px; width: 180px; height: 180px; border-radius: 28px; background: var(--blue);"></span>
        <span class="service__n">02</span>
        <div class="service__body">
          <h3>Consulting</h3>
          <p>Stuck, or not sure where to start? Bring me any question. “Can you help with my Squarespace site?” “I built a site with AI. How do I get it live?” “What kind of website does my business actually need?”</p>
          <span class="service__includes">Advice · Fixes · Launch help
        </div>
      </article>
      <article class="panel service" style="background: var(--mint);">
        <span class="shape" aria-hidden="true" style="right: -40px; top: -40px; width: 180px; height: 180px; border-radius: 180px 180px 0 0; background: var(--yellow);"></span>
        <span class="service__n">03</span>
         <div class="service__body">
          <h3>Web apps</h3>
          <p>Custom Ruby on Rails applications and features: booking, memberships, dashboards, APIs.</p>
          <span class="service__includes">Rails · PostgreSQL · JavaScript · Support</span>
        </div>
      </article>
    </div>
  </section>

  <section id="work" class="work">
    <div class="wrap">
      <h2 class="display h-section">Selected <span class="serif" style="color: var(--yellow);">work</span></h2>
      <% code_projects.each do |project| %>
        <div class="work-row">
          <span class="work-row__mark" aria-hidden="true" style="background: <%= project[:color] %>; border-radius: <%= project[:radius] %>;"></span>
          <% if project[:url] %>
            <%= link_to project[:title], project[:url], class: "work-row__title", target: "_blank", rel: "noopener" %>
          <% else %>
            <span class="work-row__title"><%= project[:title] %></span>
          <% end %>
          <span class="work-row__body"><%= project[:body] %></span>
          <span class="work-row__tag"><%= project[:tag] %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section id="about" class="wrap about">
    <div class="about__photo">
      <span class="shape" aria-hidden="true" style="left: 0; top: 30px; width: 300px; height: 300px; border-radius: 50%; background: var(--yellow);"></span>
      <%= image_tag "two_worlds/portrait.jpg", alt: "Portrait of Annie Walsh" %>
    </div>
    <div class="about__text">
      <h2 class="display">Hi, I’m <span class="serif" style="color: var(--blue);">Annie.</span></h2>
      <p class="about__lead">Before becoming a software developer, I spent years working in the performing arts sector as a stage, house and company manager. I retrained at Le Wagon London in 2021 and now build tools for theater and civic tech at Any One Thing.</p>
      <p class="about__sub">Originally from New Hampshire. When I’m not building or dancing, I’m cycling around Regent’s Park on a bike called Kamala.</p>
      <ul class="tags" aria-label="Tools I use">
        <% [["Ruby on Rails", "yellow"], ["JavaScript", "pink"], ["SQL", "mint"], ["Tailwind", "lilac"], ["Bootstrap", "yellow"], ["Heroku", "pink"], ["Render", "mint"], ["Git & GitHub", "lilac"], ["Cloudflare", "yellow"], ["Domains", "pink"], ["Squarespace", "mint"], ["Claude Code", "lilac"]].each do |label, colour| %>
          <li style="background: var(--<%= colour %>);"><%= label %></li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="wrap--tight" style="padding-bottom: 16px;">
    <div class="panel cta-block">
      <span class="shape" aria-hidden="true" style="left: -80px; bottom: -120px; width: 280px; height: 280px; border-radius: 50%; background: var(--pink);"></span>
      <h2 class="display">Got a project? <br><span class="serif">Let’s talk.</span></h2>
      <%= link_to "Message me on LinkedIn", linkedin_url, class: "pill pill--ink", target: "_blank", rel: "noopener" %>
    </div>
  </section>
</main>

<footer class="wrap site-footer">
  <div class="site-footer__links">
    <%= link_to "GitHub", "https://github.com/awalsh3", target: "_blank", rel: "noopener" %>
    <%= link_to "LinkedIn", linkedin_url, target: "_blank", rel: "noopener" %>
  </div>
  <%= link_to "Over on the other side: Dance →", dance_path %>
  <span>© <%= Date.current.year %> Annie Walsh</span>
</footer>
